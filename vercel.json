{
  "version": 2,
  "functions": {
    "api/checkout.js":  { "memory": 256, "maxDuration": 10 },
    "api/subscribe.js": { "memory": 256, "maxDuration": 10 },
    "api/finalize.js":  { "memory": 256, "maxDuration": 10 }
  },
  "routes": [
    { "src": "/api/checkout",  "dest": "/api/checkout.js"  },
    { "src": "/api/subscribe", "dest": "/api/subscribe.js" },
    { "src": "/api/finalize",  "dest": "/api/finalize.js"  },
    { "src": "/",              "dest": "/index.html"        }
  ]
}
